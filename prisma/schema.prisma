// Cocolis.ca - Schéma Prisma V2
// Commission plateforme : 15% | Conducteur : 85%

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum ShipmentStatus {
  AVAILABLE
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum EscrowStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED_TO_DRIVER
  REFUNDED
}

enum VerificationStatus {
  UNVERIFIED
  PHONE_VERIFIED
  FULLY_VERIFIED // phone + ID
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  name               String
  avatarUrl          String?
  phone              String?
  role               UserRole           @default(USER)
  stripeAccountId    String?            // Stripe Connect Express Account ID
  rating             Float              @default(5.0)
  completedTrips     Int                @default(0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  shipmentsSent  Shipment[]  @relation("SenderShipments")
  proposalsMade  Proposal[]  @relation("DriverProposals")
  messagesSent   Message[]   @relation("SenderMessages")
  reviewsGiven   Review[]    @relation("ReviewerUser")
  reviewsReceived Review[]   @relation("ReviewedUser")
}

model Shipment {
  id            String         @id @default(uuid())
  titleFr       String
  titleEn       String
  descriptionFr String
  descriptionEn String
  category      String         // furniture | electronics | parcel | sports | moving | auto

  // Origine
  originCity    String
  originProvince String
  originName    String
  originLat     Float
  originLng     Float
  originPostal  String?

  // Destination
  destCity      String
  destProvince  String
  destName      String
  destLat       Float
  destLng       Float
  destPostal    String?

  priceCAD      Float          // Budget max expéditeur en CAD
  weightKg      Float
  dimensions    String         // ex: "120 x 80 x 50 cm"
  vehicleNeededFr String
  vehicleNeededEn String
  distanceKm    Float
  departureDate DateTime
  flexibleDate  Boolean        @default(true)
  status        ShipmentStatus @default(AVAILABLE)
  deliveryMode  String         @default("home") // "home" | "depanneur_relay"

  senderId      String
  sender        User           @relation("SenderShipments", fields: [senderId], references: [id])

  proposals     Proposal[]
  messages      Message[]
  escrowPayment EscrowPayment?
  reviews       Review[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Proposal {
  id             String   @id @default(uuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  driverId       String
  driver         User     @relation("DriverProposals", fields: [driverId], references: [id])

  offerAmountCAD Float
  travelDate     DateTime
  driverMessage  String?
  isAccepted     Boolean  @default(false)

  createdAt      DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  senderId   String
  sender     User     @relation("SenderMessages", fields: [senderId], references: [id])

  text             String
  isOfferProposal  Boolean @default(false)
  proposedPrice    Float?

  createdAt  DateTime @default(now())
}

model EscrowPayment {
  id                    String       @id @default(uuid())
  shipmentId            String       @unique
  shipment              Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String       @unique
  grossAmountCAD        Float
  platformFeeCAD        Float        // 15% commission Cocolis
  driverPayoutCAD       Float        // 85% conducteur

  deliveryCode          String       // Code à 6 chiffres envoyé par SMS
  status                EscrowStatus @default(PENDING)

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model Review {
  id           String   @id @default(uuid())
  shipmentId   String
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  reviewerId   String
  reviewer     User     @relation("ReviewerUser", fields: [reviewerId], references: [id])

  reviewedId   String
  reviewed     User     @relation("ReviewedUser", fields: [reviewedId], references: [id])

  rating       Int      // 1 à 5
  comment      String

  createdAt    DateTime @default(now())
}
