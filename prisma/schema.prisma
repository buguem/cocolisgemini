// Prisma Schema V2 pour Cocolis Canada (cocolis.ca)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SENDER
  TRANSPORTER
  BOTH
}

enum Language {
  FR
  EN
}

enum AnnouncementStatus {
  ACTIVE
  RESERVED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  HELD
  RELEASED
  REFUNDED
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  phone             String?
  phoneVerified     Boolean  @default(false)
  idDocumentUrl     String?
  role              Role     @default(BOTH)
  language          Language @default(EN)
  stripeAccountId   String?
  averageRating     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  announcements     Announcement[]
  offers            Offer[]
  reviewsGiven      Review[] @relation("GivenReviews")
  reviewsReceived   Review[] @relation("ReceivedReviews")
  messages          Message[]
}

model Announcement {
  id             String             @id @default(cuid())
  userId         String
  title          String
  category       String
  dimensions     Json               // { length, width, height, unit }
  weight         Float?
  photos         String[]
  origin         Json               // { address, city, province, lat, lng, postalCode }
  destination    Json               // { address, city, province, lat, lng, postalCode }
  desiredDate    DateTime?
  isFlexible     Boolean            @default(true)
  accessInfo     String?
  budgetMax      Int                // en CAD $
  suggestedPrice Int?               // Calcul automatique
  status         AnnouncementStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())

  user           User               @relation(fields: [userId], references: [id])
  offers         Offer[]
}

model Offer {
  id               String      @id @default(cuid())
  announcementId   String
  transporterId    String
  price            Int         // en CAD $
  status           OfferStatus @default(PENDING)
  confirmationCode String?     // Code unique à 6 chiffres
  createdAt        DateTime    @default(now())

  announcement     Announcement @relation(fields: [announcementId], references: [id])
  transporter      User         @relation(fields: [transporterId], references: [id])
  messages         Message[]
  payment          Payment?
}

model Message {
  id        String   @id @default(cuid())
  offerId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  offer     Offer    @relation(fields: [offerId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])
}

model Payment {
  id              String        @id @default(cuid())
  offerId         String        @unique
  amount          Int           // en cents CAD
  platformFee     Int           // 15% commission plateforme
  stripePaymentId String?
  status          PaymentStatus @default(HELD)
  createdAt       DateTime      @default(now())
  releasedAt      DateTime?

  offer           Offer         @relation(fields: [offerId], references: [id])
}

model Review {
  id          String   @id @default(cuid())
  rating      Int      // 1 à 5 étoiles
  comment     String?
  reviewerId  String
  reviewedId  String
  offerId     String
  createdAt   DateTime @default(now())

  reviewer    User     @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewed    User     @relation("ReceivedReviews", fields: [reviewedId], references: [id])
}
